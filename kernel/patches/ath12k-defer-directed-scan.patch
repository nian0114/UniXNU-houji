+/* Complete the UI scan only after a directed request waiting behind it runs. */
+static bool finish_scan_locked(void) {
+  if (scan_queued.operation && (!ui.operation || ui.operation == NW_CONTROL_SCAN_REQUEST)) {
+    ui = scan_queued;
+    scan_current = scan_queued;
+    memset(&scan_queued, 0, sizeof(scan_queued));
+    scan_deadline = lx_now_ms() + 12000;
+    return false;
+  }
+  scan_waiting = false;
+  if (status.state == NW_STA_SCANNING) status.state = NW_STA_IDLE;
+  return true;
+}
+
+static void cancel_scan_locked(void) {
+  memset(&scan_queued, 0, sizeof(scan_queued));
+  if (scan_waiting) { scan_waiting = false; scan_ack_pending = true; }
+}
+
+static bool same_scan(const struct ui_request *a, const struct ui_request *b) {
+  return a->ssid_length == b->ssid_length && a->scan_frequency_count == b->scan_frequency_count &&
+    !memcmp(a->ssid, b->ssid, a->ssid_length) && !memcmp(a->scan_frequencies, b->scan_frequencies,
+                                                        a->scan_frequency_count * sizeof(u32));
+}
